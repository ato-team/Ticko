{
	"name": "ticko",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"engines": {
		"bun": "1.4.x"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "bun test",
		"check:domain-deps": "bun run scripts/check-domain-deps.ts",
		"api": "bun run packages/api/src/main.ts",
		"worker": "bun run packages/worker/src/main.ts",
		"db:migrate": "bun run --cwd packages/storage migrate",
		"db:check": "bun run --cwd packages/storage check",
		"cli": "bun run packages/worker/src/cli.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
